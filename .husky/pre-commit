#!/usr/bin/env sh
# Verify i18n translation files are in sync (same keys, same order) before every commit.
# Fails fast if any language file is missing a key, has an extra key, or keys are out of order.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
CLASSIFYRE="$REPO_ROOT"

echo "Checking i18n key parity (web)..."
cd "$CLASSIFYRE/apps/web"
bun test lib/i18n-keys.spec.ts --silent
echo "Web i18n OK"

echo "Checking i18n key parity (api)..."
cd "$CLASSIFYRE/apps/api"
bun test src/i18n/i18n-keys.spec.ts --silent
echo "API i18n OK"

echo "Checking generated docs artifacts..."
cd "$CLASSIFYRE"
node scripts/extract-helm-values.mjs --check
echo "Docs generated artifacts OK"

echo "Regenerating CLI notebook runtime packages..."
cd "$CLASSIFYRE/apps/cli"
uv run python scripts/generate_runtime_packages.py
RUNTIME_PACKAGES_FILE="$REPO_ROOT/packages/schemas/src/schemas/notebook_runtime_packages.json"
if ! git diff --quiet -- "$RUNTIME_PACKAGES_FILE"; then
  git add "$RUNTIME_PACKAGES_FILE"
  echo "notebook_runtime_packages.json was stale; regenerated and staged"
else
  echo "notebook_runtime_packages.json OK"
fi

CODEGEN_PATHS="packages/api-client/src/generated apps/cli/src/models packages/schemas apps/api/openapi.json openapi.json"

echo "Running codegen..."
cd "$CLASSIFYRE"
bun run codegen
if ! git diff --quiet -- $CODEGEN_PATHS; then
  git add -- $CODEGEN_PATHS
  echo "codegen output was stale; regenerated and staged"
else
  echo "codegen output OK"
fi

echo "Regenerating docs artifacts..."
cd "$CLASSIFYRE"
bun run docs:generate
if ! git diff --quiet -- apps/docs/src/_generated; then
  git add -- apps/docs/src/_generated
  echo "docs artifacts were stale; regenerated and staged"
else
  echo "docs artifacts OK"
fi
