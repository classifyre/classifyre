{
  "capabilities": [
    {
      "id": "workspace.view",
      "scope": "workspace",
      "description": "Open the workspace."
    },
    {
      "id": "settings.view",
      "scope": "workspace",
      "description": "See the workspace settings: language and time, workers, cleanup, MCP, SQL and scan limits. Never held by visitors of a public workspace."
    },
    {
      "id": "activity.view",
      "scope": "workspace",
      "description": "Read who changed and read what in the workspace (Activity, History). Never held by visitors of a public workspace."
    },
    {
      "id": "workspace.settings",
      "scope": "workspace",
      "description": "Change workspace settings, embeddings, maintenance and background queues."
    },
    {
      "id": "workspace.pause",
      "scope": "workspace",
      "description": "Pause and resume the workspace."
    },
    {
      "id": "workspace.publish",
      "scope": "workspace",
      "description": "Make the workspace public (read-only for everyone of the tenant, and for visitors of the first tenant) or private again."
    },
    {
      "id": "workspace.delete",
      "scope": "workspace",
      "description": "Delete the workspace."
    },
    {
      "id": "notification.view",
      "scope": "workspace",
      "description": "Get the notifications sent to your groups in the workspace, and mark them read, important or dismissed for yourself."
    },
    {
      "id": "access.view",
      "scope": "workspace",
      "description": "See who has access to the workspace."
    },
    {
      "id": "access.manage",
      "scope": "workspace",
      "description": "Give and remove access to the workspace."
    },
    {
      "id": "source.view",
      "scope": "workspace",
      "description": "Read sources and their scans. Their configuration and notebook code need source.manage."
    },
    {
      "id": "source.manage",
      "scope": "workspace",
      "description": "Create, change and delete sources."
    },
    {
      "id": "source.run",
      "scope": "workspace",
      "description": "Start, stop and re-run scans."
    },
    {
      "id": "source.purge",
      "scope": "workspace",
      "description": "Remove the assets or findings a source produced."
    },
    {
      "id": "finding.view",
      "scope": "workspace",
      "description": "Read findings, extractions and their evidence."
    },
    {
      "id": "finding.triage",
      "scope": "workspace",
      "description": "Change finding status and severity, alone or in bulk."
    },
    {
      "id": "asset.view",
      "scope": "workspace",
      "description": "Read assets, lineage, connections and duplicates."
    },
    {
      "id": "asset.tag",
      "scope": "workspace",
      "description": "Tag assets, add or remove connections, save explore views."
    },
    {
      "id": "asset.govern",
      "scope": "workspace",
      "description": "Govern assets: owners, stewards, custodians, descriptions and lifecycle."
    },
    {
      "id": "detector.view",
      "scope": "workspace",
      "description": "Read detectors, their tests and training history."
    },
    {
      "id": "detector.manage",
      "scope": "workspace",
      "description": "Create, change and delete detectors and their tests."
    },
    {
      "id": "detector.train",
      "scope": "workspace",
      "description": "Train detectors and give them feedback."
    },
    {
      "id": "code.author",
      "scope": "workspace",
      "description": "Write and run code: custom source notebooks and code detectors."
    },
    {
      "id": "case.view",
      "scope": "workspace",
      "description": "Read cases, their boards, threads and timelines."
    },
    {
      "id": "case.edit",
      "scope": "workspace",
      "description": "Create cases and work on them."
    },
    {
      "id": "case.manage",
      "scope": "workspace",
      "description": "Close, reopen, clean up and delete cases."
    },
    {
      "id": "inquiry.view",
      "scope": "workspace",
      "description": "Read inquiries and their matches."
    },
    {
      "id": "inquiry.edit",
      "scope": "workspace",
      "description": "Create, change and delete inquiries."
    },
    {
      "id": "lead.review",
      "scope": "workspace",
      "description": "Propose, accept and dismiss case leads."
    },
    {
      "id": "glossary.view",
      "scope": "workspace",
      "description": "Read the glossary, bindings and semantic links."
    },
    {
      "id": "glossary.edit",
      "scope": "workspace",
      "description": "Write glossary terms, schemes, relations and bindings."
    },
    {
      "id": "glossary.approve",
      "scope": "workspace",
      "description": "Approve glossary terms, bindings and suggestions."
    },
    {
      "id": "entity.view",
      "scope": "workspace",
      "description": "Read entities and their values."
    },
    {
      "id": "entity.manage",
      "scope": "workspace",
      "description": "Create, merge and change entities."
    },
    {
      "id": "correlation.review",
      "scope": "workspace",
      "description": "Decide duplicates and change correlation settings."
    },
    {
      "id": "agent.view",
      "scope": "workspace",
      "description": "Read agent configuration, runs, memory and AI providers."
    },
    {
      "id": "agent.configure",
      "scope": "workspace",
      "description": "Configure agents, AI providers and MCP servers."
    },
    {
      "id": "agent.use",
      "scope": "workspace",
      "description": "Ask the assistant and use AI completion."
    },
    {
      "id": "data.export",
      "scope": "workspace",
      "description": "Export data out of the workspace (CSV, archives)."
    },
    {
      "id": "data.query",
      "scope": "workspace",
      "description": "Query the rows of tables with SQL: every table here, or only the sources and tables a grant names."
    },
    {
      "id": "data.connect",
      "scope": "workspace",
      "description": "Create your own SQL connections for BI tools and drivers (PostgreSQL protocol)."
    },
    {
      "id": "data.connection.manage",
      "scope": "workspace",
      "description": "See, give and revoke the SQL connections of everyone in the workspace."
    },
    {
      "id": "mcp.token.own",
      "scope": "workspace",
      "description": "Create and revoke your own MCP tokens."
    },
    {
      "id": "mcp.token.admin",
      "scope": "workspace",
      "description": "See and revoke every MCP token of the workspace."
    },
    {
      "id": "tenant.workspace.create",
      "scope": "tenant",
      "description": "Create workspaces for a group you belong to."
    },
    {
      "id": "tenant.access.manage",
      "scope": "tenant",
      "description": "Manage grants across the tenant."
    },
    {
      "id": "tenant.categories.manage",
      "scope": "tenant",
      "description": "Manage workspace categories."
    },
    {
      "id": "tenant.audit.view",
      "scope": "tenant",
      "description": "Read the tenant audit trail."
    },
    {
      "id": "platform.tenants.manage",
      "scope": "platform",
      "description": "Create and change tenants."
    }
  ],
