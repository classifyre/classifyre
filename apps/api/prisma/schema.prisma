model InstanceSettings {
  id                        Int                @id @default(1)
  mcpEnabled                Boolean            @default(true) @map("mcp_enabled")
  language                  InstanceLanguage   @default(AUTOMATIC)
  timezone                  String             @default("AUTOMATIC")
  timeFormat                InstanceTimeFormat @default(AUTOMATIC) @map("time_format")
  aiProviderConfigId        String?            @map("ai_provider_config_id")
  harnessAiProviderConfigId String?            @map("harness_ai_provider_config_id")

  hfTokenEnc String? @map("hf_token_enc")

  // Investigation autopilot — instance-wide defaults. Per-entity aiMode on
  // Inquiry/Case overrides these when not INHERIT.
  // Per-agent prompt steering lives on AgentConfig.goal, not here: the
  // *Guidance/*Desired/*Searchable columns that used to sit alongside these
  // flags were written by the settings API and read by nothing, so they were
  // dropped rather than left to look configurable.
  autopilotInquiryEnabled    Boolean @default(true) @map("autopilot_inquiry_enabled")
  autopilotCaseEnabled       Boolean @default(true) @map("autopilot_case_enabled")
  // Config-tuning agent: may change editable source config (detectors,
  // sampling, optional, resources) — never base connection.
  autopilotConfigEnabled     Boolean @default(true) @map("autopilot_config_enabled")
  // Detector-authoring agent: may create/train custom detectors.
  autopilotDetectorEnabled   Boolean @default(true) @map("autopilot_detector_enabled")
  // Escalation agent: reviews open cases and raises operator notifications for
  // high-severity ones so the harness can run unattended.
  autopilotEscalationEnabled Boolean @default(true) @map("autopilot_escalation_enabled")
  // Allow the harness to call tools from connected external MCP servers.
  autopilotMcpEnabled        Boolean @default(true) @map("autopilot_mcp_enabled")

  // Harness limits, promoted from hardcoded constants so an operator can size
  // them to their corpus. Defaults are the values those constants held, so an
  // upgraded instance behaves exactly as before.
  //
  // A run holds one of the instance's namespace job slots, so a wedged run
  // does not fail alone — it stalls every queue behind it. The budget is the
  // per-run ceiling; stale-after is when a RUNNING row is presumed dead and
  // reaped ("Run exceeded its maximum lifetime").
  harnessRunBudgetMinutes       Int   @default(20) @map("harness_run_budget_minutes")
  harnessRunStaleAfterMinutes   Int   @default(60) @map("harness_run_stale_after_minutes")
  harnessCycleBudgetMinutes     Int   @default(30) @map("harness_cycle_budget_minutes")
  // Below BOTH of these, findings.ranked is mostly zeros and the triage
  // doctrine has nothing to stand on, so gated agents wait. The absolute floor
  // is the honest question; the ratio is the fallback for small corpora.
  harnessEvidenceUsableFindings Int   @default(2000) @map("harness_evidence_usable_findings")
  harnessEvidenceUsableCoverage Float @default(0.25) @map("harness_evidence_usable_coverage")
  // Above this coverage the missions are no longer warned that scores are
  // partial. Distinct from the gate above: this shapes the prompt, not the run.
  harnessEvidenceWarnCoverage   Float @default(0.8) @map("harness_evidence_warn_coverage")
  // Importance at or above which a single finding earns an express cycle.
  harnessExpressImportance      Float @default(0.75) @map("harness_express_importance")
  // Transcript guards. The ReAct transcript is quadratic by construction —
  // every iteration appends its tool results and resends the whole thing — so
  // these bound one observation and one turn's worth of them. Characters, not
  // tokens: the ratio is stable enough and a tokenizer per provider would be
  // a lot of machinery for a budget that only has to be approximately right.
  harnessObservationChars       Int   @default(8000) @map("harness_observation_chars")
  harnessTurnObservationChars   Int   @default(24000) @map("harness_turn_observation_chars")
  // How much of the corpus each run is shown.
  harnessMaxRankedFindings      Int   @default(25) @map("harness_max_ranked_findings")
  harnessMaxGlossaryEntries     Int   @default(20) @map("harness_max_glossary_entries")
  harnessMaxRecalledMemories    Int   @default(30) @map("harness_max_recalled_memories")
  // How often the DREAM agent consolidates memory, in days.
  harnessDreamIntervalDays      Int   @default(2) @map("harness_dream_interval_days")

  // Master switch for the adaptive scheduler. Sources stay in AUTO mode when
  // this is off; the tick simply starts nothing, so flipping it back on resumes
  // exactly where each source was. The kill switch for "stop scanning now".
  autoScheduleEnabled Boolean @default(true) @map("auto_schedule_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  aiProviderConfig        AiProviderConfig? @relation("AssistantAiProvider", fields: [aiProviderConfigId], references: [id], onDelete: SetNull)
  harnessAiProviderConfig AiProviderConfig? @relation("HarnessAiProvider", fields: [harnessAiProviderConfigId], references: [id], onDelete: SetNull)

  @@map("instance_settings")
}

