model Runner {
  id                   String               @id @default(uuid())
  sourceId             String               @map("source_id")
  triggeredAt          DateTime             @default(now()) @map("triggered_at")
  triggeredBy          String?              @map("triggered_by")
  triggerType          TriggerType          @default(MANUAL) @map("trigger_type")
  executionMode        RunnerExecutionMode? @map("execution_mode")
  status               RunnerStatus         @default(PENDING)
  startedAt            DateTime?            @map("started_at")
  completedAt          DateTime?            @map("completed_at")
  durationMs           Int?                 @map("duration_ms")
  assetsCreated        Int                  @default(0) @map("assets_created")
  assetsUpdated        Int                  @default(0) @map("assets_updated")
  // Findings currently associated with this run: every finding it created,
  // re-detected, or resolved. NOT a count of new discoveries — after
  // reconciliation it is closer to "the source's open set as of this run".
  // Use findingsCreated for "what did this run actually find that was new".
  totalFindings        Int                  @default(0) @map("total_findings")
  // Findings first seen by this run. Accumulated as batches land, so it is a
  // true creation count rather than a post-reconciliation snapshot.
  findingsCreated      Int                  @default(0) @map("findings_created")
  findingsResolved     Int                  @default(0) @map("findings_resolved")
  findingsRetained     Int                  @default(0) @map("findings_retained")
  // Assets that should have carried text but yielded none — mostly OCR and
  // transcription returning empty. Not errors: nothing failed, the content was
  // simply never read. Tracked because a run can otherwise report complete
  // success while silently covering none of the asset's actual content.
  assetsWithoutText    Int                  @default(0) @map("assets_without_text")
  // Aggregate of runner_assets.text_extraction_status. Kept as JSON so new
  // coverage states can be added without widening the runner table again.
  textCoverage         Json?                @map("text_coverage") @db.JsonB
  // The source's AUTOMATIC sampling cursor as it stood when this run finished.
  //
  // Snapshotted so the adaptive scheduler can tell "the sweep moved through new
  // ground" from "the sweep is going over ground it already covered" — the only
  // signal that distinguishes them, and the one whose absence stopped a sweep
  // at 900 of 9600 objects. Opaque and source-defined; compared for equality
  // only, never interpreted.
  samplingCursor       Json?                @map("sampling_cursor") @db.JsonB
  errorMessage         String?              @map("error_message")
  errorDetails         Json?                @map("error_details")
  jobName              String?              @map("job_name")
  jobNamespace         String?              @map("job_namespace")
  assetsUnchanged      Int                  @default(0) @map("assets_unchanged")
  assetsDeleted        Int                  @default(0) @map("assets_deleted")
  // Assets retained despite being absent from this run because the source's
  // scope moved since they were ingested. They are NOT deleted and their
  // findings stay OPEN — see AssetService.finalizeIngestRun.
  assetsOutOfScope     Int                  @default(0) @map("assets_out_of_scope")
  // Assets this run skipped entirely because their content and every applicable
  // detector configuration were unchanged since their last completed scan. Their
  // findings were carried forward, not re-detected.
  assetsSkippedCached  Int                  @default(0) @map("assets_skipped_cached")
  // Individual detector runs avoided across all assets, including the partial
  // skips on assets where only some detectors had to re-run. This is the number
  // that shows what the cache is actually worth.
  detectorRunsSkipped  Int                  @default(0) @map("detector_runs_skipped")
  // Fingerprint of the scope-determining config this run covered.
  scopeFingerprint     String?              @map("scope_fingerprint") @db.VarChar(64)
  // Fingerprint of the DETECTION-determining config (detectors, custom
  // detectors, sampling) this run covered. Lets the autopilot answer "has what
  // we look for changed since I last re-scanned this source?" — the difference
  // between a legitimate verification re-scan and a runaway loop.
  detectionFingerprint String?              @map("detection_fingerprint") @db.VarChar(64)
  assets               Asset[]
  runnerAssets         RunnerAsset[]
  source               Source               @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  notifications        Notification[]

  @@index([sourceId])
  @@index([executionMode])
  @@index([status])
  @@index([triggeredAt])
  @@map("runners")
}

model RunnerAsset {
  runnerId             String                 @map("runner_id")
  assetHash            String                 @map("asset_hash")
  status               RunnerAssetStatus      @default(PENDING)
  // What this run did to the asset. Null for rows written before this existed,
  // and for assets discovered but never ingested.
  changeType           RunnerAssetChangeType? @map("change_type")
  startedAt            DateTime?              @map("started_at")
  completedAt          DateTime?              @map("completed_at")
  errorMessage         String?                @map("error_message") @db.Text
  findingsTotal        Int?                   @map("findings_total")
  findingsBySeverity   Json?                  @map("findings_by_severity")
  findingsByDetector   Json?                  @map("findings_by_detector")
  metadata             Json?                  @map("metadata") @db.JsonB
  // Per-detector outcome for this asset, as reported by the CLI:
  // [{ detector_type, custom_detector_key, status: OK|ERROR, error }].
  // A finding may only be auto-resolved for absence when its detector has an
  // OK outcome here — a detector that crashed (or never ran) proves nothing
  // about whether its earlier findings are still present.
  detectorOutcomes     Json?                  @map("detector_outcomes") @db.JsonB
  // The asset should have carried text but yielded none (typically OCR or
  // transcription returning empty). Null for rows written before this existed.
  emptyText            Boolean?               @map("empty_text")
  // Structured outcome from the CLI text/OCR/transcription path. Unlike
  // emptyText, this distinguishes a genuinely empty result from missing
  // engines, zero decoded video frames, and other extraction failures.
  textExtractionStatus TextExtractionStatus?  @map("text_extraction_status")
  // This run skipped the asset entirely on scan-cache evidence rather than
  // scanning it. `detectorOutcomes` is empty for such a row — which is exactly
  // what keeps the asset's existing findings from being resolved for absence.
  cacheHit             Boolean                @default(false) @map("cache_hit")
  createdAt            DateTime               @default(now()) @map("created_at")

  runner Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  @@id([runnerId, assetHash])
  @@index([runnerId, status])
  @@index([runnerId, changeType])
  @@index([runnerId, textExtractionStatus])
  @@map("runner_assets")
}

