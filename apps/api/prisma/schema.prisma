generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Source {
  id                         String                      @id @default(uuid())
  name                       String
  description                String?                     @db.Text
  type                       AssetType
  config                     Json
  runnerStatus               RunnerStatus?               @default(PENDING) @map("runner_status")
  consecutiveFailures        Int                         @default(0) @map("consecutive_failures")
  lastRunStatus              RunnerStatus?               @map("last_run_status")
  lastRunAt                  DateTime?                   @map("last_run_at")
  lastErrorMessage           String?                     @map("last_error_message")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  currentRunnerId            String?                     @map("current_runner_id")
  scheduleEnabled            Boolean                     @default(false) @map("schedule_enabled")
  scheduleCron               String?                     @map("schedule_cron")
  scheduleTimezone           String?                     @default("UTC") @map("schedule_timezone")
  // When the next automatic run is due. Only AUTO mode writes it; CRON leaves
  // the timing to pg-boss and OFF clears it.
  scheduleNextAt             DateTime?                   @map("schedule_next_at")
  // How this source is scheduled. `scheduleEnabled` remains the CRON on/off
  // switch (pg-boss reads it); this column is what decides WHICH scheduler owns
  // the source, so the two can never both be driving it.
  scheduleMode               SourceScheduleMode          @default(OFF) @map("schedule_mode")
  // AUTO-mode state machine. CATCH_UP re-runs back-to-back while each run is
  // still ingesting new data; STEADY is the slow "check only what's new"
  // cadence reached once a run stops making progress; BACKOFF and PAUSED are
  // the failure paths. See AutoScheduleService.
  autoPhase                  AutoSchedulePhase           @default(CATCH_UP) @map("auto_phase")
  // Current STEADY interval in seconds. Doubles on every consecutive
  // no-progress run (bounded), and resets the moment a run ingests something.
  autoIntervalSeconds        Int?                        @map("auto_interval_seconds")
  // Consecutive completed runs that ingested nothing new. The sweep is
  // considered converged once this crosses the promotion threshold.
  autoNoProgressStreak       Int                         @default(0) @map("auto_no_progress_streak")
  // Back-to-back catch-up runs since the last convergence. A source whose
  // content genuinely changes on every scan would otherwise never converge and
  // would sit at the catch-up cadence forever; this bounds that.
  autoCatchUpRuns            Int                         @default(0) @map("auto_catch_up_runs")
  // Operator-facing explanation of the last scheduling decision, so "why is
  // this source scanning every 6 hours" is answerable without reading logs.
  autoReason                 String?                     @map("auto_reason") @db.Text
  // The last run already folded into the schedule. pg-boss is at-least-once, so
  // without this a redelivered completion message would advance the phase twice
  // off one run.
  autoLastRunnerId           String?                     @map("auto_last_runner_id")
  // Opaque, source-defined cursor for AUTOMATIC sampling. Persisted at the end
  // of each run and injected into the next run so extraction picks up where it
  // left off (incremental ingestion). The API never interprets its contents.
  samplingCursor             Json?                       @map("sampling_cursor") @db.JsonB
  // Per-source autopilot management mode; overrides the instance config flag
  // unless INHERIT. OBSERVE_ONLY blocks the config-tuning agent from changing
  // this source's config.
  aiMode                     AiManagementMode            @default(INHERIT) @map("ai_mode")
  // Set when a scan of this source completes, cleared after a corpus-wide
  // autopilot cycle successfully processes that exact timestamp. The set of
  // non-null rows IS the pending batch, so the coalescing window needs no
  // separate cycle-state table: many scans finishing inside one window fold
  // into a single cycle that sees them all.
  autopilotDirtyAt           DateTime?                   @map("autopilot_dirty_at")
  assets                     Asset[]
  findings                   Finding[]
  customDetectorFeedback     CustomDetectorFeedback[]
  customDetectorTrainingRuns CustomDetectorTrainingRun[]
  runners                    Runner[]
  notifications              Notification[]
  customDetectorExtractions  CustomDetectorExtraction[]
  assetChunks                AssetChunk[]
  uploadedFiles              UploadedSourceFile[]
  notebookExecutions         NotebookExecution[]

  @@index([currentRunnerId])
  @@index([scheduleEnabled])
  @@index([autopilotDirtyAt])
  @@index([lastRunAt])
  // The auto-scheduler's due-set query: "AUTO sources whose next run has come".
  @@index([scheduleMode, scheduleNextAt])
  @@map("sources")
}

/**
 * Which scheduler owns a source.
 * OFF   — nothing runs it automatically.
 * CRON  — a fixed pg-boss cron schedule (the operator picked a wall-clock time).
 * AUTO  — the adaptive scheduler: run back-to-back while there is still data to
 * ingest, then settle into a slow "check only what's new" cadence.
 */
enum SourceScheduleMode {
  OFF
  CRON
  AUTO
}

/**
 * AUTO-mode phase. See AutoScheduleService for the transitions.
 */
enum AutoSchedulePhase {
  /**
   * The last run ingested new data — there is more to sweep, go again soon.
   */
  CATCH_UP
  /**
   * The sweep converged — re-check on a slow, self-widening interval.
   */
  STEADY
  /**
   * The last run failed — exponential backoff, capped.
   */
  BACKOFF
  /**
   * Too many consecutive failures: auto runs stopped until an operator acts.
   */
  PAUSED
}

/**
 * One run of a CUSTOM source's notebook.
 * `cells` is a snapshot, not a reference. An execution has to be reproducible
 * and auditable after the notebook has moved on, so it records the exact source
 * that ran rather than pointing at a row someone will edit five minutes later.
 */
model NotebookExecution {
  id           String                  @id @default(uuid())
  sourceId     String                  @map("source_id")
  revision     Int
  mode         NotebookExecutionMode
  targetCellId String?                 @map("target_cell_id")
  status       NotebookExecutionStatus @default(PENDING)
  // The cells as they were when this execution was requested.
  cells        Json
  outputs      Json?
  failedCellId String?                 @map("failed_cell_id")
  error        Json?
  durationMs   Int?                    @map("duration_ms")
  triggeredBy  String?                 @map("triggered_by")
  // Set only for the Kubernetes path, so a cancel can find the Job to delete.
  jobName      String?                 @map("job_name")
  jobNamespace String?                 @map("job_namespace")
  startedAt    DateTime?               @map("started_at")
  finishedAt   DateTime?               @map("finished_at")
  createdAt    DateTime                @default(now()) @map("created_at")

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, createdAt(sort: Desc)])
  @@index([status])
  @@map("notebook_executions")
}

enum NotebookExecutionMode {
  CELL
  ALL
  TEST_CONNECTION
  PREVIEW_EXTRACT
}

enum NotebookExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  ERROR
  CANCELLED
  TIMEOUT
}

model UploadedSourceFile {
  id               String   @id @default(uuid())
  sourceId         String   @map("source_id")
  fileName         String   @map("file_name")
  declaredMimeType String   @map("declared_mime_type")
  fileExtension    String   @map("file_extension")
  fileSizeBytes    Int      @map("file_size_bytes")
  contentHash      String   @map("content_hash") @db.VarChar(64)
  data             Bytes
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, contentHash])
  @@index([sourceId, createdAt(sort: Desc)])
  @@index([contentHash])
  @@map("source_files")
}

model Asset {
  id                        String                     @id @default(uuid())
  hash                      String
  checksum                  String
  name                      String
  externalUrl               String                     @map("external_url")
  links                     Json                       @default("[]") @db.JsonB
  // Catalog asset kind (file, image, page, comment, table, ...) — free-form
  // string, not a database enum.
  assetType                 String                     @map("asset_type")
  sourceType                AssetType                  @map("source_type")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  sourceId                  String                     @map("source_id")
  lastScannedAt             DateTime?                  @map("last_scanned_at")
  runnerId                  String?                    @map("runner_id")
  status                    AssetStatus                @default(NEW)
  // Fingerprint of the source scope this asset was last ingested under. An
  // asset may only be marked DELETED for absence when this matches the current
  // scope — otherwise its absence means the scope moved, not that the object is
  // gone. Null for assets ingested before scope fingerprinting existed; they
  // are treated as out-of-scope (retained) until their next ingest.
  scopeFingerprint          String?                    @map("scope_fingerprint") @db.VarChar(64)
  // SHA-256 of the bytes that were actually scanned. Distinct from `checksum`,
  // which hashes source-reported *metadata* (for a local folder, just mtime and
  // size) and so cannot tell a restored backup from an unmodified file.
  contentHash               String?                    @map("content_hash") @db.VarChar(64)
  // Scan-cache state written by the CLI once everything for this asset
  // succeeded: `{ detectors: { <type|CUSTOM::key>: <config fingerprint> },
  // content_hash, findings_total, findings_by_severity, findings_by_detector,
  // empty_text, text_extraction_status }`.
  //
  // Its presence is the proof that the last scan of this asset completed — a run
  // that died partway never writes it, so the next run redoes the work. A later
  // run skips a detector only while its fingerprint still matches, which is what
  // makes a detector-config edit re-run that detector alone.
  scanCache                 Json?                      @map("scan_cache") @db.JsonB
  // How far a sampling strategy has read into this asset's tabular payload:
  // `{ v, kind, offset, rows_seen, passes, exhausted, checksum, strategy }`.
  //
  // Source-level sampling bounds how many assets a run touches; this bounds how
  // much of one asset it reads. An AUTOMATIC run resumes at `offset` and wraps
  // back to 0 once a pass covers the file. Deliberately not folded into
  // `scanCache`: that column is proof a scan completed and only exists for
  // sources that opted into caching, whereas a position must be kept either way.
  //
  // `checksum` binds the offset to the bytes it was measured against, so an
  // edited file restarts its sweep instead of resuming into rows that moved.
  payloadCursor             Json?                      @map("payload_cursor") @db.JsonB
  metadata                  Json?                      @db.JsonB
  runner                    Runner?                    @relation(fields: [runnerId], references: [id])
  source                    Source                     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  findings                  Finding[]
  customDetectorExtractions CustomDetectorExtraction[]
  correlationValues         AssetCorrelationValue[]
  signature                 AssetSignature?
  clusterMember             AssetClusterMember?
  chunks                    AssetChunk[]

  @@unique([sourceId, hash])
  @@index([hash])
  @@index([sourceType])
  @@index([assetType])
  @@index([externalUrl])
  @@index([runnerId])
  @@index([lastScannedAt])
  @@index([sourceId])
  @@index([status])
  @@index([sourceId, scopeFingerprint])
  @@index([sourceId, contentHash])
  // Corpus-wide duplicate grouping (`GROUP BY content_hash HAVING count(*) > 1`,
  // see CorrelationService.linkIdenticalContent). The composite above leads with
  // source_id and so cannot serve a query that deliberately spans sources —
  // byte-identical content circulating BETWEEN systems is the interesting case.
  @@index([contentHash])
  @@map("assets")
}

model Finding {
  id                String @id @default(uuid())
  detectionIdentity String @unique @map("detection_identity") @db.VarChar(64)

  assetId            String       @map("asset_id")
  sourceId           String       @map("source_id")
  runnerId           String?      @map("runner_id")
  detectorType       DetectorType @map("detector_type")
  findingType        String       @map("finding_type")
  category           String
  severity           Severity
  confidence         Decimal      @db.Decimal(3, 2)
  matchedContent     String       @map("matched_content") @db.Text
  redactedContent    String?      @map("redacted_content") @db.Text
  contextBefore      String?      @map("context_before") @db.Text
  contextAfter       String?      @map("context_after") @db.Text
  location           Json?        @db.JsonB
  metadata           Json?        @db.JsonB
  customDetectorId   String?      @map("custom_detector_id")
  customDetectorKey  String?      @map("custom_detector_key")
  customDetectorName String?      @map("custom_detector_name")
  // Hash of the normalized matched content plus surrounding context used by
  // the intrinsic embedding pipeline. The vector itself is content-addressed
  // in ContentEmbedding so repeated evidence is stored only once.
  embedContentHash   String?      @map("embed_content_hash") @db.VarChar(64)

  // Denormalized copy of FindingEvidenceAnalysis.importanceScore, kept in sync
  // by a DB trigger (see migration add_finding_importance_and_detected_at_index).
  // Lets the default "sort by importance" search use a single-table index scan
  // instead of a full join+sort across the whole findings/evidence tables.
  // Defaults to 0 so a finding with no evidence analysis yet sorts last under a
  // plain DESC order (no NULLS-ordering needed, so the @@index matches the DB).
  importanceScore Float @default(0) @map("importance_score")

  status           FindingStatus @default(OPEN)
  resolutionReason String?       @map("resolution_reason") @db.Text
  comment          String?       @db.Text

  history Json @default("[]") @db.JsonB

  detectedAt      DateTime  @map("detected_at")
  firstDetectedAt DateTime? @map("first_detected_at")
  lastDetectedAt  DateTime? @map("last_detected_at")
  resolvedAt      DateTime? @map("resolved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  asset                  Asset                     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  source                 Source                    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  customDetector         CustomDetector?           @relation(fields: [customDetectorId], references: [id], onDelete: SetNull)
  customDetectorFeedback CustomDetectorFeedback[]
  notifications          Notification[]
  extraction             CustomDetectorExtraction?
  evidenceAnalysis       FindingEvidenceAnalysis?
  correlationValues      AssetCorrelationValue[]

  // [assetId] alone is deliberately absent: it is the leading prefix of both
  // [assetId, lastDetectedAt] and [assetId, status, severity, ...] below, and
  // carrying a third 509 MB copy of the same column only competes for cache.
  @@index([sourceId])
  @@index([runnerId])
  @@index([detectorType])
  // Detector usage stats group by detector and count distinct sources; the
  // trailing sourceId keeps that an index-only scan. Supersedes the
  // single-column [customDetectorId] index, which was a prefix of this one.
  @@index([customDetectorId, sourceId])
  @@index([customDetectorKey])
  @@index([findingType])
  @@index([severity])
  // [status] alone is deliberately absent: one distinct value in practice, and
  // a leading prefix of [status, detectedAt] below.
  @@index([detectionIdentity, status])
  // Charts aggregate counts per (firstDetectedAt, severity, status) over a
  // window. Carrying severity and status makes that aggregation index-only
  // instead of 3M heap fetches. Supersedes the single-column [firstDetectedAt]
  // index, which was a prefix of this one. [lastDetectedAt] is dropped: 0
  // scans across all 17 namespace schemas and 436 MB.
  @@index([firstDetectedAt, severity, status])
  // [resolvedAt] dropped: zero scans across every schema, and the column is
  // NULL for every row, so no query regressed.
  @@index([embedContentHash])
  @@index([assetId, lastDetectedAt(sort: Desc)])
  @@index([assetId, status, severity, detectorType, findingType])
  // Default search ordering: importance desc, then recency.
  @@index([importanceScore(sort: Desc), lastDetectedAt(sort: Desc)])
  // Discovery/charts window queries filter on detectedAt (+ status).
  @@index([detectedAt])
  @@index([status, detectedAt])
  @@map("findings")
}

/// Workspace-level overrides for the embedding subsystem.
///
/// Every column is nullable and every null means "inherit the deployment
/// default" — the Helm values on Kubernetes, the bundled defaults in the
/// desktop app, read through EmbeddingConfigService. That is the whole point
/// of the table: an operator can retune one workspace from the settings page
/// without redeploying, and the UI can still show what the deployment asked
/// for next to what this workspace chose. A row of all-nulls is therefore
/// indistinguishable from having no row at all, which is what a fresh
/// workspace gets.
///
/// Singleton per namespace schema, mirroring InstanceSettings.
model EmbeddingSettings {
  id Int @id @default(1)

  // ── Space identity ────────────────────────────────────────────────────────
  // These six define the vector coordinate system (see EmbeddingSpace's unique
  // tuple). Changing any of them means existing vectors are no longer
  // comparable to new ones, so the API purges and re-embeds rather than
  // letting two incompatible generations share a space.
  enabled    Boolean?
  provider   String?
  model      String?
  revision   String?
  dimensions Int?
  pooling    String?
  normalize  Boolean?

  // ── Remote provider ───────────────────────────────────────────────────────
  // When provider = openai-compatible, the base URL and API key come from a
  // saved AI provider rather than being re-entered here: the key is already
  // encrypted at rest there and rotating it in one place fixes every consumer.
  aiProviderConfigId String? @map("ai_provider_config_id")

  // ── Throughput and inference ──────────────────────────────────────────────
  // Safe to change without a rebuild: they affect how vectors are produced,
  // never what a vector means.
  batchSize         Int?     @map("batch_size")
  workerConcurrency Int?     @map("worker_concurrency")
  maxParallelCalls  Int?     @map("max_parallel_calls")
  intraOpThreads    Int?     @map("intra_op_threads")
  dtype             String?
  device            String?
  autoBackfill      Boolean? @map("auto_backfill")

  // ── Index tuning ──────────────────────────────────────────────────────────
  // m and efConstruction are baked into an HNSW index at build time, so
  // changing them only takes effect for indexes built afterwards.
  hnswM              Int? @map("hnsw_m")
  hnswEfConstruction Int? @map("hnsw_ef_construction")
  hnswEfSearch       Int? @map("hnsw_ef_search")

  // ── Rebuild bookkeeping ───────────────────────────────────────────────────
  // Persisted rather than held in memory so the settings page can still report
  // "a rebuild was interrupted" after an API restart — which, given a rebuild
  // is the longest-running operation this system has, is a real state.
  rebuildStartedAt   DateTime? @map("rebuild_started_at")
  rebuildCompletedAt DateTime? @map("rebuild_completed_at")
  rebuildError       String?   @map("rebuild_error")
  /// What the rebuild was for, shown in the UI's history line.
  rebuildReason      String?   @map("rebuild_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  aiProviderConfig AiProviderConfig? @relation("EmbeddingAiProvider", fields: [aiProviderConfigId], references: [id], onDelete: SetNull)

  @@map("embedding_settings")
}

// A model revision is an immutable vector coordinate system. Model changes
// create a new space so old and new embeddings can coexist during validation.
model EmbeddingSpace {
  id                 String    @id @default(uuid())
  provider           String
  model              String
  revision           String
  dim                Int
  pooling            String
  normalized         Boolean   @default(true)
  isActive           Boolean   @default(false) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  lastRecalibratedAt DateTime? @map("last_recalibrated_at")

  embeddings ContentEmbedding[]
  analyses   FindingEvidenceAnalysis[]

  @@unique([provider, model, revision, dim, pooling, normalized])
  @@index([isActive])
  @@map("embedding_spaces")
}

model ContentEmbedding {
  id          String                @id @default(uuid())
  spaceId     String                @map("space_id")
  contentHash String                @map("content_hash") @db.VarChar(64)
  vec         Unsupported("vector")
  createdAt   DateTime              @default(now()) @map("created_at")

  space EmbeddingSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, contentHash])
  @@index([contentHash])
  @@map("content_embeddings")
}

model AssetChunk {
  id          String   @id @default(uuid())
  assetId     String   @map("asset_id")
  sourceId    String   @map("source_id")
  ordinal     Int
  page        Int?
  charOffset  Int      @map("char_offset")
  charLength  Int      @map("char_length")
  text        String   @db.Text
  contentHash String   @map("content_hash") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")

  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([assetId, ordinal])
  @@index([sourceId])
  @@index([contentHash])
  @@map("asset_chunks")
}

// Ranking is deliberately separate from detector severity. The reasons and
// signals are persisted so every score shown in the UI or MCP is explainable.
model FindingEvidenceAnalysis {
  findingId          String   @id @map("finding_id")
  spaceId            String   @map("space_id")
  importanceScore    Float    @default(0) @map("importance_score")
  qualityScore       Float    @default(0) @map("quality_score")
  semanticOutlier    Float    @default(0) @map("semantic_outlier")
  similarCount       Int      @default(0) @map("similar_count")
  duplicateGroupHash String?  @map("duplicate_group_hash") @db.VarChar(64)
  reasons            Json     @default("[]") @db.JsonB
  signals            Json     @default("{}") @db.JsonB
  analyzedAt         DateTime @default(now()) @map("analyzed_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  finding Finding        @relation(fields: [findingId], references: [id], onDelete: Cascade)
  space   EmbeddingSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([importanceScore(sort: Desc)])
  @@index([qualityScore(sort: Desc)])
  @@index([duplicateGroupHash])
  @@map("finding_evidence_analyses")
}

model CustomDetectorExtraction {
  id String @id @default(uuid())

  findingId         String  @unique @map("finding_id")
  customDetectorId  String? @map("custom_detector_id")
  customDetectorKey String  @map("custom_detector_key")
  sourceId          String  @map("source_id")
  assetId           String  @map("asset_id")
  runnerId          String? @map("runner_id")

  detectorVersion Int    @default(1) @map("detector_version")
  payloadHash     String @map("payload_hash") @db.VarChar(64)

  extractedAt DateTime @map("extracted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  finding        Finding           @relation(fields: [findingId], references: [id], onDelete: Cascade)
  source         Source            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  asset          Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  customDetector CustomDetector?   @relation(fields: [customDetectorId], references: [id], onDelete: SetNull)
  payload        ExtractionPayload @relation(fields: [payloadHash], references: [contentHash], onDelete: Restrict)

  @@index([customDetectorKey])
  @@index([customDetectorId])
  @@index([sourceId])
  @@index([assetId])
  @@index([runnerId])
  @@index([payloadHash])
  @@map("custom_detector_extractions")
}

// Custom detector runners attach the same page-level pipeline result to every
// finding on that page. Store the JSON once and reference it by content hash.
model ExtractionPayload {
  contentHash    String   @id @map("content_hash") @db.VarChar(64)
  pipelineResult Json     @map("pipeline_result") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at")

  extractions CustomDetectorExtraction[]

  // Dedup probes this table by jsonb value-equality (migrated rows have a
  // content_hash that is not derived from the payload, so they can only be
  // found by value). Hash, not btree: btree entries cap at ~8191 bytes and a
  // large payload would fail INSERT outright.
  @@index([pipelineResult], type: Hash)
  @@map("extraction_payloads")
}

model CustomDetectorFeedback {
  id                 String        @id @default(uuid())
  customDetectorId   String?       @map("custom_detector_id")
  sourceId           String        @map("source_id")
  customDetectorKey  String        @map("custom_detector_key")
  customDetectorName String?       @map("custom_detector_name")
  findingId          String?       @map("finding_id")
  findingType        String?       @map("finding_type")
  label              String?
  matchedContent     String        @map("matched_content") @db.Text
  status             FindingStatus
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  customDetector CustomDetector? @relation(fields: [customDetectorId], references: [id], onDelete: SetNull)
  source         Source          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  finding        Finding?        @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@index([customDetectorId])
  @@index([sourceId, customDetectorKey])
  @@index([findingId])
  @@index([status])
  @@map("custom_detector_feedback")
}

model CustomDetector {
  id                  String           @id @default(uuid())
  key                 String           @unique
  name                String
  description         String?          @db.Text
  pipelineSchema      Json             @map("pipeline_schema") @db.JsonB
  isActive            Boolean          @default(true) @map("is_active")
  version             Int              @default(1)
  // Per-detector autopilot management mode (overrides the instance detector
  // flag unless INHERIT). OBSERVE_ONLY blocks the detector-authoring agent.
  aiMode              AiManagementMode @default(INHERIT) @map("ai_mode")
  lastTrainedAt       DateTime?        @map("last_trained_at")
  lastTrainingSummary Json?            @map("last_training_summary") @db.JsonB
  aiProviderConfigId  String?          @map("ai_provider_config_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

