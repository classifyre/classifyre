// Generic, directed relationship between any two graph entities.
// `fromType`/`toType` are entity kinds ("asset" | "finding", room for
// "concept" later) and the ids reference the corresponding rows. The
// relation type is a free-form string so the inference engine (and a
// future ingestion path) can introduce new kinds without a migration.
model Edge {
  id           String     @id @default(uuid())
  fromType     String     @map("from_type")
  fromId       String     @map("from_id")
  toType       String     @map("to_type")
  toId         String     @map("to_id")
  relationType String     @map("relation_type")
  confidence   Decimal    @default(1.00) @db.Decimal(3, 2)
  origin       EdgeOrigin @default(INFERRED)
  metadata     Json?      @db.JsonB
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([fromType, fromId, toType, toId, relationType])
  @@index([fromType, fromId])
  @@index([toType, toId])
  @@index([relationType])
  @@map("edges")
}

// ─── ASSET CORRELATION / DUPLICATE DETECTION ─────────────────────────────
//
// Deterministic "evidence fingerprints" derived from findings. No embeddings:
// each finding's normalized value becomes a correlatable token; the reverse
// index (value_hash → assets) keeps candidate lookups cheap, and weighted +
// Jaccard overlap produces explainable similarity. See apps/api/src/correlation.

// One normalized, correlatable finding value attached to an asset. This is the
// reverse index: querying by `valueHash` yields every asset sharing a value.
// `label` is the finding's free-form type (email, phone, custom labels, …) so
// correlation stays label-agnostic.
model AssetCorrelationValue {
  id                String       @id @default(uuid())
  assetId           String       @map("asset_id")
  sourceId          String       @map("source_id")
  // Representative OPEN finding that produced this asset/value occurrence.
  // Nullable so correlation rows created before this field was introduced can
  // be resolved lazily by the occurrences endpoint and self-healed in place.
  findingId         String?      @map("finding_id")
  label             String
  detectorType      DetectorType @map("detector_type")
  customDetectorKey String?      @map("custom_detector_key")
  normalizedValue   String       @map("normalized_value") @db.Text
  // sha256(label + ':' + normalizedValue) — the reverse-index key.
  valueHash         String       @map("value_hash") @db.VarChar(64)
  // sha256 of sorted DoubleMetaphone codes for each token in the value.
  // Non-null only for text-like labels (person, name, address, …) where
  // phonetic similarity is meaningful. Used as a second blocking key so
  // "John Smith" and "Jon Smyth" end up as correlation candidates.
  phoneticHash      String?      @map("phonetic_hash") @db.VarChar(64)
  createdAt         DateTime     @default(now()) @map("created_at")

  asset   Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  finding Finding? @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@unique([assetId, valueHash])
  @@index([valueHash])
  @@index([assetId])
  @@index([findingId])
  @@index([sourceId])
  @@index([label, phoneticHash])
  @@map("asset_correlation_values")
}

// Per-asset signature: component hashes (one per label) for fast same-category
// matching plus an all-values hash that buckets exact duplicates.
model AssetSignature {
  assetId         String   @id @map("asset_id")
  sourceId        String   @map("source_id")
  // { "email": "<hash>", "phone": "<hash>", ... } — hash of sorted values per label.
  componentHashes Json     @map("component_hashes") @db.JsonB
  allValuesHash   String   @map("all_values_hash") @db.VarChar(64)
  valueCount      Int      @map("value_count")
  updatedAt       DateTime @updatedAt @map("updated_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([allValuesHash])
  @@index([sourceId])
  @@map("asset_signatures")
}

// An identity cluster: a connected group of assets that share enough strong
// evidence to be treated as the same entity. Members are maintained by the
// duplicates finder via union-find over likely-duplicate edges.
model AssetCluster {
  id          String   @id @default(uuid())
  label       String?
  memberCount Int      @default(0) @map("member_count")
  sourceCount Int      @default(0) @map("source_count")
  // Common findings across members, e.g. [{ label, value, count }] — for the UI.
  topValues   Json?    @map("top_values") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members AssetClusterMember[]

  @@index([memberCount])
  @@map("asset_clusters")
}

model AssetClusterMember {
  clusterId String   @map("cluster_id")
  assetId   String   @map("asset_id")
  addedAt   DateTime @default(now()) @map("added_at")

  cluster AssetCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  asset   Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([clusterId, assetId])
  // An asset belongs to at most one cluster.
  @@unique([assetId])
  @@index([clusterId])
  @@map("asset_cluster_members")
}

// Singleton tuning for the correlation engine. Weights are keyed by the
// (normalized) finding label and are fully dynamic — any label, including
// custom-detector ones, can be given a weight; unlisted labels fall back to
// defaultWeight. Editing this triggers a full recompute (logged as a
// DUPLICATES FINDER run). Defaults mirror correlation.constants.ts.
model CorrelationConfig {
  id            Int      @id @default(1)
  labelWeights  Json     @default("{}") @map("label_weights") @db.JsonB
  defaultWeight Int      @default(1) @map("default_weight")
  relatedMin    Decimal  @default(0.30) @map("related_min") @db.Decimal(3, 2)
  duplicateMin  Decimal  @default(0.60) @map("duplicate_min") @db.Decimal(3, 2)
  // Values to ignore when fingerprinting (noise like Person "null"). Array of
  // { id, mode: "value"|"regex"|"label", label, value }. Applied at indexing
  // time; editing triggers a full recompute.
  exclusions    Json     @default("[]") @map("exclusions") @db.JsonB
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("correlation_config")
}

// Last complete payload returned by the unscoped correlation graph endpoint.
// A single row per namespace keeps the expensive graph assembly off the HTTP
// read path while requested/built versions make invalidation lossless across
// API and worker replicas. The previous payload remains readable while a new
// version is being assembled.
model CorrelationGraphSnapshot {
  id               Int       @id @default(1)
  requestedVersion BigInt    @default(1) @map("requested_version")
  builtVersion     BigInt    @default(0) @map("built_version")
  payload          Json?     @db.JsonB
  builtAt          DateTime? @map("built_at")
  buildDurationMs  Int?      @map("build_duration_ms")
  lastError        String?   @map("last_error") @db.Text
  lastInvalidation String?   @map("last_invalidation") @db.Text
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("correlation_graph_snapshot")
}

// Scratch space for a recompute pass: the pairwise overlap aggregation
// (GROUP BY over the asset_correlation_values self-join) runs as a single
// INSERT ... SELECT so the heavy intermediate state lives in Postgres
// (work_mem / on-disk temp files), never in the API process's heap. Rows are
// scoped by run_id and deleted once that run's edges have been written.
model CorrelationPairStaging {
  id             BigInt  @id @default(autoincrement())
  runId          String  @map("run_id")
  aId            String  @map("a_id")
  bId            String  @map("b_id")
  sharedCount    Int     @map("shared_count")
  weightedShared Decimal @map("weighted_shared") @db.Decimal(12, 4)
  sharedByLabel  Json    @map("shared_by_label") @db.JsonB

  @@index([runId, id])
  @@map("correlation_pair_staging")
}

enum InquiryStatus {
  ACTIVE
  ARCHIVED
}

// The investigation. A case owns hypotheses and the real, persisted evidence. It
// may link one or more questions (saved queries) that guide which findings are
// relevant; evidence is pulled from those queries' matches or added manually.
model Case {
  id          String           @id @default(uuid())
  title       String
  description String?          @db.Text
  status      CaseStatus       @default(OPEN)
  severity    Severity         @default(MEDIUM)
  assignee    String?
  createdBy   String?          @map("created_by")
  aiMode      AiManagementMode @default(INHERIT) @map("ai_mode")
  conclusion  String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  evidence     CaseEvidence[]
  findings     CaseFinding[]
  notes        CaseNote[]
  inquiryLinks CaseInquiry[]
  threads      CaseThread[]
  activities   CaseActivity[]
  leads        CaseLead[]
  events       CaseEvent[]

  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@map("cases")
}

// ── Case leads (exploration triage) ─────────────────────────────────────────
// Ranked candidates that MIGHT belong in a case: semantic neighbours of
// accepted evidence, high-importance inquiry matches, autopilot proposals, or
// manual bookmarks. A lead is not evidence — accepting one creates the
// CaseEvidence/CaseFinding through the normal attach flow; dismissing one is
// remembered so agents stop re-proposing it.

enum CaseLeadOrigin {
  SEMANTIC_NEIGHBOR
  INQUIRY
  AUTOPILOT
  MANUAL
}

enum CaseLeadStatus {
  PROPOSED
  ACCEPTED
  DISMISSED
}

model CaseLead {
  id         String         @id @default(uuid())
  caseId     String         @map("case_id")
  findingId  String         @map("finding_id")
  assetId    String?        @map("asset_id")
  origin     CaseLeadOrigin
  status     CaseLeadStatus @default(PROPOSED)
  rationale  String         @db.Text
  // Snapshots at proposal time (findings may be reconciled later).
  title      String
  importance Float?
  similarity Float?
  proposedBy String         @map("proposed_by")
  reviewedBy String?        @map("reviewed_by")
  reviewedAt DateTime?      @map("reviewed_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  investigation Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, findingId])
  @@index([caseId, status])
  @@map("case_leads")
}

// ── Case events (real-world chronology) ─────────────────────────────────────
// Dated events extracted from evidence or entered by the investigator — the
// investigation's chronology, distinct from CaseActivity (the audit trail of
// who did what in the app).

enum CaseEventPrecision {
  DAY
  MONTH
  YEAR
}

model CaseEvent {
  id          String             @id @default(uuid())
  caseId      String             @map("case_id")
  occurredAt  DateTime           @map("occurred_at")
  precision   CaseEventPrecision @default(DAY)
  title       String
  description String?            @db.Text
  confidence  Float?
  origin      AgentMemoryOrigin  @default(OPERATOR)
  verifiedAt  DateTime?          @map("verified_at")
  verifiedBy  String?            @map("verified_by")
  findingIds  String[]           @default([]) @map("finding_ids")
  evidenceIds String[]           @default([]) @map("evidence_ids")
  createdBy   String             @map("created_by")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  investigation Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, occurredAt])
  @@map("case_events")
}

// A saved query / monitor. It does NOT persist evidence — it only defines matchers
// and tracks which findings currently match (QuestionMatch) so we can surface new
// matches. An inquiry is standalone or linked to any number of cases (CaseInquiry).
//
// Matchers: a finding matches iff source matches AND (detector OR customDetector
// matches) AND type matches, where an empty list for a dimension means "any".
// findingTypeRegex is evaluated in the app (findingType is dynamic for CUSTOM).
model Inquiry {
  id          String           @id @default(uuid())
  title       String
  description String?          @db.Text
  status      InquiryStatus    @default(ACTIVE)
  createdBy   String?          @map("created_by")
  aiMode      AiManagementMode @default(INHERIT) @map("ai_mode")

  matchAllSources    Boolean        @default(false) @map("match_all_sources")
  sourceIds          String[]       @map("source_ids")
  detectorTypes      DetectorType[] @map("detector_types")
  customDetectorKeys String[]       @map("custom_detector_keys")
  findingTypes       String[]       @map("finding_types")
  findingTypeRegex   String[]       @map("finding_type_regex")
  findingValueRegex  String[]       @map("finding_value_regex")

  matchCount    Int       @default(0) @map("match_count")
  newMatchCount Int       @default(0) @map("new_match_count")
  matchesSeenAt DateTime? @map("matches_seen_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  caseLinks CaseInquiry[]

  @@index([status])
  @@map("inquiries")
}

// Many-to-many link: an inquiry can guide several cases and a case can be
// driven by several inquiries. Deleting either side removes only the link.
model CaseInquiry {
  id        String   @id @default(uuid())
  caseId    String   @map("case_id")
  inquiryId String   @map("inquiry_id")
  createdAt DateTime @default(now()) @map("created_at")

  case    Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@unique([caseId, inquiryId])
  @@index([inquiryId])
  @@map("case_inquiries")
}

// An observed node attached to a CASE. Display
// fields are denormalized snapshots so the node survives source-row deletion.
model CaseEvidence {
  id         String   @id @default(uuid())
  caseId     String   @map("case_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  label      String?
  assetType  String?  @map("asset_type")
  sourceType String?  @map("source_type")
  note       String?  @db.Text
  addedBy    String?  @map("added_by")
  createdAt  DateTime @default(now()) @map("created_at")

  investigation Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  findings      CaseFinding[]

  @@unique([caseId, entityType, entityId])
  @@index([caseId])
  @@index([entityType, entityId])
  @@map("case_evidence")
}

// Inferred observation anchored to case evidence. No FK to findings; findingId is a
// plain reference. Denormalized snapshots survive deletion of the finding row.
model CaseFinding {
  id                 String   @id @default(uuid())
  caseId             String   @map("case_id")
  caseEvidenceId     String   @map("case_evidence_id")
  findingId          String   @map("finding_id")
  label              String
  severity           String?
  detectorType       String?  @map("detector_type")
  customDetectorName String?  @map("custom_detector_name")
  matchedContent     String?  @map("matched_content") @db.Text
  note               String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at")

  investigation Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseEvidence  CaseEvidence @relation(fields: [caseEvidenceId], references: [id], onDelete: Cascade)

  @@unique([caseId, findingId])
  @@index([caseId])
  @@index([caseEvidenceId])
  // "Is this finding cited by a case?" — asked per scan, per config read and
  // per detector-value query, and answered by joining case_findings to
  // findings. The unique index above leads with case_id, so a finding_id
  // predicate can only scan it in full and filter; this one seeks. That is
  // what makes the alternative join order (drive from findings by source_id,
  // probe case_findings) worth choosing once case evidence stops being small.
  @@index([findingId])
  @@map("case_findings")
}

model CaseNote {
  id        String   @id @default(uuid())
  caseId    String   @map("case_id")
  body      String   @db.Text
  author    String?
  createdAt DateTime @default(now()) @map("created_at")

  investigation Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("case_notes")
}

// Thread container: hypothesis thread (replaces Hypothesis) or custom discussion thread.
model CaseThread {
  id                String            @id @default(uuid())
  caseId            String            @map("case_id")
  kind              CaseThreadKind    @default(HYPOTHESIS)
  title             String
  // Hypothesis-only denormalized current state (for graph/quick queries)
  status            HypothesisStatus? @default(PROPOSED)
  confidence        Decimal?          @db.Decimal(3, 2)
  testablePredicate String?           @map("testable_predicate") @db.Text
  color             String?
  createdBy         String?           @map("created_by")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  investigation Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  entries       CaseThreadEntry[]
  support       CaseThreadSupport[]

  @@index([caseId])
  @@index([caseId, kind])
  @@map("case_threads")
}

// Append-only evolution log for a thread (notes, statement revisions, status changes).
model CaseThreadEntry {
  id        String              @id @default(uuid())
  threadId  String              @map("thread_id")
  entryType CaseThreadEntryType @default(NOTE) @map("entry_type")
  body      String?             @db.Text
  metadata  Json?               @db.JsonB
  author    String?
  createdAt DateTime            @default(now()) @map("created_at")

  thread  CaseThread          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  support CaseThreadSupport[]

  @@index([threadId, createdAt])
  @@map("case_thread_entries")
}

// Polymorphic link between a thread (and optionally an entry) and evidence/finding.
model CaseThreadSupport {
  id         String         @id @default(uuid())
  threadId   String         @map("thread_id")
  entryId    String?        @map("entry_id")
  targetType String         @map("target_type")
  targetId   String         @map("target_id")
  stance     EvidenceStance @default(SUPPORTS)
  weight     Decimal?       @db.Decimal(3, 2)
  note       String?        @db.Text
  createdAt  DateTime       @default(now()) @map("created_at")

  thread CaseThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  entry  CaseThreadEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@unique([threadId, targetType, targetId])
  @@index([threadId])
  @@index([targetType, targetId])
  @@map("case_thread_support")
}

// Append-only case event log — the unified timeline.
model CaseActivity {
  id           String           @id @default(uuid())
  caseId       String           @map("case_id")
  activityType CaseActivityType @map("activity_type")
  actor        String?
  payload      Json?            @db.JsonB
  createdAt    DateTime         @default(now()) @map("created_at")

  investigation Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt(sort: Desc)])
  @@map("case_activities")
}

// ── Investigation autopilot ──────────────────────────────────────────────────
// Autonomous background agents that manage inquiries and cases after scans.
// Every cycle is an AgentRun; every (non-)action is an AgentDecision with a
// mandatory rationale; learned domain knowledge lives in AgentMemory.

// Per-entity override of the instance-wide autopilot flags. OBSERVE_ONLY means
// the agent may read the entity but never mutate it.
enum AiManagementMode {
  INHERIT
  MANAGED
  OBSERVE_ONLY
}

enum AgentKind {
  INQUIRY
  CASE
  // Periodic "dreaming": memory consolidation — dedupe, prune noise, distill
  // important lessons. No inquiry/case mutations.
  DREAM
  // Deterministic asset-correlation step (no LLM). Runs after a scan, before
  // the inquiry/case agents, and records its work in the autopilot log so the
  // results are visible and the AI agents can take them into account.
  DUPLICATES
  // Config-tuning agent: investigates sources by changing editable config
  // (detectors, sampling, optional, resources) — never base connection.
  CONFIG
  // Detector-authoring agent: creates/trains custom detectors when needed.
  DETECTOR_AUTHOR
  // Alerting/escalation agent: reviews open cases and notifies an operator when
  // a high-severity case appears, so the harness can run unattended. Mutates
  // nothing in the investigation graph — it only raises operator notifications.
  ESCALATION
  // Conversational chat-gateway turn (Telegram/Slack bot). Never enqueued by
  // the autopilot pipeline; one run per inbound chat message for usage/audit.
  CHAT
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
  // Stopped by the operator; the runtime aborts before the next step.
  CANCELLED
}

enum AgentDecisionAction {
  CREATE_INQUIRY
  UPDATE_INQUIRY
  ENRICH_INQUIRY_MATCHERS
  SIGNAL_CASE_READY
  CREATE_CASE
  UPDATE_CASE
  ADD_HYPOTHESIS
  UPDATE_HYPOTHESIS
  ADD_EVIDENCE
  ATTACH_FINDINGS
  ADD_NOTE
  ADD_THREAD_ENTRY
  CREATE_EDGE
  // Disconnect a manual edge the data no longer supports (focused case runs).
  REMOVE_EDGE
  // Link evidence/findings to a hypothesis thread (supports/contradicts).
  LINK_SUPPORT
  CHANGE_STATUS
  LINK_INQUIRY
  // Dream-mode memory maintenance (prune / rewrite / merge).
  CONSOLIDATE_MEMORY
  // Duplicates finder: a pairwise asset-correlation link was created/updated.
  LINK_DUPLICATE
  // Duplicates finder: an identity cluster was created/grown/merged.
  UPDATE_CLUSTER
  // Harness: a generic tool was invoked by the agent loop (read or mutate).
  TOOL_CALL
  // Config-tuning agent: a source's editable config was changed.
  TUNE_SOURCE
  // Detector-authoring agent: a custom detector was created.
  CREATE_DETECTOR
  // Detector-authoring agent: a custom detector was trained.
  TRAIN_DETECTOR
  // Detector-authoring agent: a custom detector was updated (config/active flag).
  UPDATE_DETECTOR
  // Detector-authoring agent: a custom detector was deleted.
  DELETE_DETECTOR
  // Config-tuning agent: a source scan was triggered.
  TRIGGER_SCAN
  // Harness: the living system brief was updated.
  UPDATE_SYSTEM_BRIEF
  // Fingerprints: recomputed asset correlation/similarity on demand.
  RECOMPUTE_CORRELATION
  // Fingerprints: tuned correlation config (weights/exclusions/thresholds).
  TUNE_CORRELATION
  // Escalation agent: raised an operator notification about a high-severity case.
  NOTIFY_OPERATOR
  NO_ACTION
}

enum AgentDecisionOutcome {
  APPLIED
  SKIPPED_OBSERVE_ONLY
  FAILED
}

enum AgentMemoryKind {
  DECISION_PRECEDENT
  // Topic → any entity (inquiry/case/source/detector) mapping for dedupe.
  ENTITY_MAP
  // Per-source learned facts: typical finding mix, false-positive patterns,
  // detector/sampling settings that worked well.
  SOURCE_PROFILE
  // What a detector catches/misses and tuning lessons.
  DETECTOR_INSIGHT
  // Sacred operator corrections/opt-outs — never pruned by the dream agent.
  OPERATOR_DIRECTIVE
}

// An external MCP server the harness can connect to and call tools from.
// Credentials (headers) are encrypted at rest. agentKinds scopes which missions
// may use the server's tools (empty = all). Untrusted servers expose their tools
// observe-only (the dispatcher refuses to run their mutating handlers).
model McpServerConfig {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  transport       String // "stdio" | "http"
  command         String?
  args            String[]  @default([])
  url             String?
  headersEnc      String?   @map("headers_enc")
  enabled         Boolean   @default(false)
  trusted         Boolean   @default(false)
  // Mission kinds allowed to use these tools (AgentKind strings). Empty = all.
  agentKinds      String[]  @default([]) @map("agent_kinds")
  // Discovered tool names to expose. Empty = all discovered.
  toolAllowlist   String[]  @default([]) @map("tool_allowlist")
  // Last connection result for the UI.
  discoveredTools String[]  @default([]) @map("discovered_tools")
  lastError       String?   @map("last_error") @db.Text
  lastConnectedAt DateTime? @map("last_connected_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("mcp_server_configs")
}

// Per-agent harness configuration. One optional row per AgentKind that has a
// factory mission (see harness/missions.ts). Absent columns fall back to the
// hardcoded factory default, so an absent row means "fully default". The
// operator edits these via the Harness → Agents UI to retune an agent's goal,
// iteration budget and assigned built-in tools without a code change.
/// When an agent is allowed to start. One global cadence could not serve both
/// halves of the job: an escalation that takes three minutes was paced by the
/// same gate as a config pass that takes two hours, so nothing urgent ever ran
/// promptly and nothing deliberative ever saw a settled corpus.
enum AgentTriggerMode {
  /// Runs on any qualifying event, as soon as it happens.
  EAGER
  /// Joins the coalesced batch — one cycle per window rather than per scan.
  BATCH
  /// Runs only when the corpus is quiescent, for decisions that need the whole
  /// picture rather than whatever the last scan happened to produce.
  SETTLED
  /// Runs on its own interval only.
  SCHEDULED
  /// Never starts on its own; only an operator trigger runs it.
  MANUAL
}

model AgentConfig {
  kind               AgentKind         @id
  // Override for the mission goal (system prompt). null = factory default.
  goal               String?           @db.Text
  // Override for the iteration budget. null = factory default.
  maxIterations      Int?              @map("max_iterations")
  // Assigned built-in tool names (used only when toolsOverride is true).
  toolNames          String[]          @default([]) @map("tool_names")
  // false = follow the factory toolset; true = use toolNames verbatim. Lets an
  // empty assignment ("no tools") differ from "never customised".
  toolsOverride      Boolean           @default(false) @map("tools_override")
  // Scheduling policy. Every column below is null = factory default, matching
  // the convention above, so an agent the operator has never touched keeps
  // tracking the shipped defaults instead of freezing at whatever they were on
  // the day the row was created.
  triggerMode        AgentTriggerMode? @map("trigger_mode")
  // Which readiness gates this agent waits for. Independent booleans rather
  // than one "readiness" flag because the whole point is that an agent can
  // need a settled corpus without needing inquiry matching to be idle.
  waitForMatching    Boolean?          @map("wait_for_matching")
  waitForEvidence    Boolean?          @map("wait_for_evidence")
  waitForScans       Boolean?          @map("wait_for_scans")
  // Guardrails, not triggers. The floor stops a burst of source completions
  // spawning a run apiece; the backstop forces a run when gates have held the
  // agent back for too long, and is the liveness guarantee for a gated agent.
  minIntervalMinutes Int?              @map("min_interval_minutes")
  maxStalenessHours  Int?              @map("max_staleness_hours")
  // Per-agent override of the instance run budget, for one agent that is
  // legitimately slower than the rest.
  runBudgetMinutes   Int?              @map("run_budget_minutes")
  // Last time this agent actually started, which is what the two guardrails
  // above compare against. Not derived from agent_runs: a run that never
  // started leaves no row, and the floor has to hold regardless.
  lastTriggeredAt    DateTime?         @map("last_triggered_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@map("agent_configs")
}

// Living, always-injected summary of the whole system the autopilot maintains:
// source/detector counts, finding landscape, what's been tried, known gaps.
// Singleton (id = 1), like InstanceSettings. The narrative is model-authored;
// `facts` holds structured aggregates refreshed from the search service.
model AgentSystemBrief {
  id        Int      @id @default(1)
  content   String   @default("") @db.Text
  facts     Json     @default("{}") @db.JsonB
  version   Int      @default(1)
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("agent_system_brief")
}

// One autonomous agent cycle (triggered by a scan completion). currentStep +
// stepState make the pipeline resumable across pg-boss redeliveries without
// repeating LLM calls whose validated output is already stored.
model AgentRun {
  id           String         @id @default(uuid())
  agentKind    AgentKind      @map("agent_kind")
  status       AgentRunStatus @default(PENDING)
  sourceId     String?        @map("source_id")
  runnerId     String?        @map("runner_id")
  // Case this run is focused on (case-targeted manual runs) — lets the case
  // workspace show "AI is working here" and surface the results.
  caseId       String?        @map("case_id")
  trigger      String         @default("scan_completed")
  // Operator instruction for manually triggered cycles ("steer" runs).
  instruction  String?        @db.Text
  // Stable identity of the cycle that produced this run — used to resume the
  // right run on pg-boss redelivery (scan: source:runner, manual: uuid).
  cycleKey     String?        @map("cycle_key")
  currentStep  String?        @map("current_step")
  stepState    Json?          @map("step_state") @db.JsonB
  attempts     Int            @default(0)
  error        String?        @db.Text
  summary      String?        @db.Text
  // LLM token consumption of this run (all iterations/attempts summed) and the
  // estimated cost derived from the provider's configured per-MTok prices at
  // the time the tokens were recorded. costUsd stays null when no pricing set.
  inputTokens  Int            @default(0) @map("input_tokens")
  outputTokens Int            @default(0) @map("output_tokens")
  costUsd      Decimal?       @map("cost_usd") @db.Decimal(14, 6)
  startedAt    DateTime?      @map("started_at")
  finishedAt   DateTime?      @map("finished_at")
  createdAt    DateTime       @default(now()) @map("created_at")

  decisions AgentDecision[]
  logs      AgentLog[]

  @@index([agentKind, createdAt(sort: Desc)])
  @@index([status])
  @@index([cycleKey])
  @@index([caseId, createdAt(sort: Desc)])
  @@map("agent_runs")
}

enum AgentLogChannel {
  // Internal mechanics: step transitions, prompts/raw model output, retries.
  TECHNICAL
  // Human-readable narrative of what the agent observed and did.
  BUSINESS
}

enum AgentLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// Append-only execution log of a run. BUSINESS entries tell the analyst the
// story; TECHNICAL entries carry raw model I/O and step mechanics (including
// the raw responses behind schema failures).
model AgentLog {
  id        String          @id @default(uuid())
  runId     String          @map("run_id")
  channel   AgentLogChannel
  level     AgentLogLevel   @default(INFO)
  message   String          @db.Text
  payload   Json?           @db.JsonB
  createdAt DateTime        @default(now()) @map("created_at")

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([runId, channel])
  @@map("agent_logs")
}

// A single agent decision — including the decision to do nothing. Rationale is
// always required; payload holds the exact mutation input for auditability.
model AgentDecision {
  id         String               @id @default(uuid())
  runId      String               @map("run_id")
  action     AgentDecisionAction
  outcome    AgentDecisionOutcome @default(APPLIED)
  entityType String?              @map("entity_type")
  entityId   String?              @map("entity_id")
  rationale  String               @db.Text
  payload    Json?                @db.JsonB
  createdAt  DateTime             @default(now()) @map("created_at")

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([entityType, entityId])
  @@index([action, createdAt(sort: Desc)])
  @@map("agent_decisions")
}

// Long-lived agent knowledge: generalized decision precedents, entity maps,
// source profiles, detector lessons and operator directives. Shared vocabulary
// lives exclusively in GlossaryTerm. weight is a reinforcement counter.
model AgentMemory {
  id         String            @id @default(uuid())
  kind       AgentMemoryKind
  key        String
  content    String            @db.Text
  tags       String[]          @default([])
  refType    String?           @map("ref_type")
  refId      String?           @map("ref_id")
  weight     Int               @default(1)
  // Provenance: agent-authored memory is a hypothesis until verified against
  // real system state; operator-authored memory is authoritative. Refreshing
  // content clears verification — the new claim has not been checked yet.
  origin     AgentMemoryOrigin @default(AGENT)
  verifiedAt DateTime?         @map("verified_at")
  verifiedBy String?           @map("verified_by")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  @@unique([kind, key])
  @@index([kind])
  @@index([tags], type: Gin)
  @@map("agent_memories")
}

enum AgentMemoryOrigin {
  AGENT
  OPERATOR
}

// ── Investigation glossary ───────────────────────────────────────────────────
// Shared vocabulary between investigators and agents: canonical terms with
// aliases and entity typing. Operators curate it in the UI; agents may propose
// terms (origin AGENT, unverified) and both consume it through MCP/missions.

enum GlossaryEntityType {
  PERSON
  ORGANIZATION
  LOCATION
  REFERENCE
  TERM
  OTHER
}

model GlossaryTerm {
  id               String              @id @default(uuid())
  term             String              @unique
  aliases          String[]            @default([])
  // Agent-suggested aliases stay out of lookup until an operator accepts them.
  proposedAliases  String[]            @default([]) @map("proposed_aliases")
  entityType       GlossaryEntityType  @default(TERM) @map("entity_type")
  notes            String?             @db.Text
  origin           AgentMemoryOrigin   @default(OPERATOR)
  verifiedAt       DateTime?           @map("verified_at")
  verifiedBy       String?             @map("verified_by")
  // Content hash of "term + aliases + notes" in the shared embedding store,
  // so glossary lookups can resolve semantically (alias/nearest-term match).
  embedContentHash String?             @map("embed_content_hash")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  references       GlossaryReference[]

  @@index([entityType])
  @@map("glossary_terms")
}

// A canonical term may be established or used by many investigation entities.
// Polymorphic ids deliberately mirror CaseEvidence: namespace-local services
// validate the target before insertion and the compound key is idempotent.
model GlossaryReference {
  id             String   @id @default(uuid())
  glossaryTermId String   @map("glossary_term_id")
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  term GlossaryTerm @relation(fields: [glossaryTermId], references: [id], onDelete: Cascade)

  @@unique([glossaryTermId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("glossary_references")
}

// ── Chat gateway (Telegram / Slack bots) ─────────────────────────────────────
// Conversational interface into the AI harness: each configured bot connects
// via long-polling (Telegram) or Socket Mode (Slack), and every chat turn runs
// the chat agent loop with the built-in MCP toolset (AgentRun kind CHAT).

enum ChatPlatform {
  TELEGRAM
  SLACK
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

model ChatBot {
  id                   String       @id @default(uuid())
  platform             ChatPlatform
  name                 String
  enabled              Boolean      @default(false)
  // Bot credentials, AES-GCM encrypted (MaskedConfigCryptoService).
  botTokenEnc          String       @map("bot_token_enc")
  // Slack Socket Mode app-level token (xapp-…); unused for Telegram.
  appTokenEnc          String?      @map("app_token_enc")
  // MCP capability group ids the bot may use (mcp-catalog.ts); empty = all.
  capabilityGroups     String[]     @default([]) @map("capability_groups")
  // AgentKinds the bot may steer via autopilot tools; empty = all.
  agentKinds           String[]     @default([]) @map("agent_kinds")
  // When false every mutating tool resolves OBSERVE_ONLY (read-only bot).
  allowMutations       Boolean      @default(true) @map("allow_mutations")
  // Connector status, mirrored by ChatGatewayService.
  lastError            String?      @map("last_error") @db.Text
  lastConnectedAt      DateTime?    @map("last_connected_at")
  // Telegram getUpdates offset — survives restarts without replaying messages.
  telegramLastUpdateId BigInt?      @map("telegram_last_update_id")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  sessions ChatSession[]

  @@map("chat_bots")
}

model ChatSession {
  id               String    @id @default(uuid())
  botId            String    @map("bot_id")
  // Platform conversation identity: Telegram chat id, Slack "channel:thread_ts".
  externalChatKey  String    @map("external_chat_key")
  title            String?
  // Compacted summary of history older than the sliding window.
  summary          String    @default("") @db.Text
  summarizedUpToAt DateTime? @map("summarized_up_to_at")
  lastMessageAt    DateTime  @default(now()) @map("last_message_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  bot      ChatBot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([botId, externalChatKey])
  @@index([botId, lastMessageAt(sort: Desc)])
  @@map("chat_sessions")
}

model ChatMessage {
  id                String          @id @default(uuid())
  sessionId         String          @map("session_id")
  role              ChatMessageRole
  content           String          @db.Text
  // Compact record of tool activity behind an assistant reply (UI/debugging).
  toolCalls         Json?           @map("tool_calls") @db.JsonB
  // AgentRun that produced this reply — links to token usage and decisions.
  agentRunId        String?         @map("agent_run_id")
  // Platform message id, deduped on connector redelivery.
  externalMessageId String?         @map("external_message_id")
  externalUserId    String?         @map("external_user_id")
  createdAt         DateTime        @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// ── Namespace data transfer (export / import) ────────────────────────────────
// One row per export or import run. Both execute asynchronously on the
// per-namespace pg-boss worker at concurrency 1, so a large transfer never
// competes with a running scan for database capacity. The UI polls this row
// (and the websocket mirrors it) for progress.

enum DataTransferKind {
  EXPORT
  IMPORT
}

enum DataTransferStatus {
  /// An import archive has been uploaded and inspected, but the operator has
  /// not yet chosen what to take from it. Nothing is queued.
  STAGED
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// How an import treats a row whose primary key already exists in the target
/// namespace. SKIP keeps what is already there; OVERWRITE replaces it.
enum DataTransferConflict {
  SKIP
  OVERWRITE
}

model DataTransferJob {
  id     String             @id @default(uuid())
  kind   DataTransferKind
  status DataTransferStatus @default(PENDING)
  /// Selected scope ids (see data-transfer/transfer-scopes.ts). A partial
  /// import carries the subset the operator picked, never more than the
  /// archive actually holds.
  scopes String[]           @default([])

  conflictMode DataTransferConflict @default(SKIP) @map("conflict_mode")

  /// The archive itself lives in {@link DataTransferChunk}, keyed by this job.
  /// `fileName` is what the operator sees on the downloaded file; `fileSize`
  /// and `checksum` describe the compressed bytes. `archived` says whether the
  /// chunks are still there — they are dropped once `expiresAt` passes.
  fileName String? @map("file_name")
  fileSize BigInt? @map("file_size")
  checksum String? @db.VarChar(64)
  archived Boolean @default(false)

  /// `totalRows` is an estimate counted before the run starts, so on a busy
  /// namespace `processedRows` can drift against it — `percent` is clamped.
  totalRows     Int     @default(0) @map("total_rows")
  processedRows Int     @default(0) @map("processed_rows")
  skippedRows   Int     @default(0) @map("skipped_rows")
  percent       Int     @default(0)
  currentTable  String? @map("current_table")

  /// Per-table row counts, e.g. `{ "sources": 12, "findings": 4310 }`.
  counts   Json @default("{}") @db.JsonB
  /// Operator-facing notes: stripped credentials, rows skipped for missing
  /// references, archive-version drift.
  warnings Json @default("[]") @db.JsonB

  errorMessage    String? @map("error_message") @db.Text
  cancelRequested Boolean @default(false) @map("cancel_requested")

  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  expiresAt  DateTime? @map("expires_at")
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  chunks DataTransferChunk[]

  @@index([status])
  @@index([kind, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("data_transfer_jobs")
}

/// One slice of an archive's compressed bytes.
///
/// The archive lives in Postgres because it is written by the worker and read
/// by the API, and those are separate deployments that share nothing but the
/// database. Split across rows rather than held in one `bytea` so both
/// directions stay streaming and bounded: the export appends a chunk and
/// forgets it, the download reads them back in order without ever assembling
/// the whole archive in memory.
model DataTransferChunk {
  jobId   String @map("job_id")
  ordinal Int
  data    Bytes

  job DataTransferJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([jobId, ordinal])
  @@map("data_transfer_chunks")
}

/// Pre-aggregated finding counts, one row per (day × dimension).
///
/// The discovery overview and the findings charts are pure aggregates over
/// `findings`, and on a real corpus every one of their predicates matches
/// essentially the whole table: `status` has n_distinct = 1 (every finding is
/// OPEN) and a scan writes every `detected_at` inside the same few days, so a
/// 30-day window is the entire table. Postgres is right to stop using the
/// indexes and sequentially scan, which is why the overview cost ~43 s of
/// database work on a 5.17M-finding workspace.
///
/// Measured on that workspace, this grain collapses 5,165,490 rows / 5.5 GB
/// into 739 rows: severity totals 13.7 s -> 8 ms, the three activity counts
/// 11.2 s -> 20 ms as a single query.
///
/// The dimensions are exactly the filters the charts can push down. A request
/// filtering on anything outside this grain (free-text search, asset, custom
/// detector) still runs live against `findings`.
model FindingStatDaily {
  day          DateTime      @db.Date
  severity     Severity
  status       FindingStatus
  detectorType DetectorType  @map("detector_type")
  sourceId     String        @map("source_id")
  count        Int

  @@id([day, severity, status, detectorType, sourceId])
  @@index([day])
  @@map("finding_stats_daily")
}

/// Pre-aggregated per-asset finding counts, one row per (day × asset ×
/// severity × status).
///
/// Kept separate from {@link FindingStatDaily} because adding `assetId` to that
/// grain would multiply it by the asset count and throw away the compression
/// that makes it work. This table answers only the overview's "top assets"
/// panel, whose live query — a full aggregate over every finding ordered by
/// count — was the single most expensive statement in the product at 18.7 s.
/// At this grain the same workspace holds 26,993 rows / 3 MB and answers in
/// 11 ms.
model FindingStatAssetDaily {
  day            DateTime      @db.Date
  assetId        String        @map("asset_id")
  severity       Severity
  status         FindingStatus
  count          Int
  lastDetectedAt DateTime      @map("last_detected_at")

  @@id([day, assetId, severity, status])
  @@index([day])
  @@map("finding_stats_asset_daily")
}

/// Days whose rollup rows no longer match `findings`.
///
/// This is the coalescing point of the refresh design. Every write that
/// changes a finding marks the affected day here (`ON CONFLICT DO NOTHING`),
/// so a scan writing findings for hours leaves exactly one row rather than one
/// job per batch. The refresh worker drains the table, recomputes only those
/// days, and deletes them — so an idle workspace does no work at all, and a
/// busy one does work proportional to the days it touched, not to the corpus.
model FindingStatsDirtyDay {
  day DateTime @id @db.Date

  @@map("finding_stats_dirty_days")
}

/// Single-row freshness record for the finding rollups.
///
/// Surfaced in the UI so the numbers on screen can say how old they are, which
/// is the honest trade for serving them from a cache: a dashboard that is
/// seconds-to-minutes stale and instant beats one that is exact and takes 43 s.
model FindingStatsState {
  id            String    @id @default("singleton")
  refreshedAt   DateTime? @map("refreshed_at")
  durationMs    Int?      @map("duration_ms")
  /// Total findings represented by the rollup — serves the unfiltered
  /// pagination total, which was itself a 2 s `count(*)`.
  totalFindings Int       @default(0) @map("total_findings")
  /// False until the first full build completes, so readers can tell "no
  /// findings yet" apart from "not built yet" and fall back accordingly.
  isBuilt       Boolean   @default(false) @map("is_built")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("finding_stats_state")
}

/// {@link FindingStatDaily} keyed on `first_detected_at` instead of
/// `detected_at`.
///
/// The two dates answer different questions and the dashboard asks both: the
/// overview reports findings by when they were last seen, while the charts plot
/// when each finding first appeared. `detected_at` also *moves* — a re-scan
/// stamps it with the new run's time — whereas `first_detected_at` is fixed at
/// creation, so a timeline built on it does not rewrite its own history every
/// time a corpus is rescanned.
///
/// Rows whose `first_detected_at` is NULL are omitted, matching the live query
/// this replaces.
model FindingStatFirstDaily {
  day          DateTime      @db.Date
  severity     Severity
  status       FindingStatus
  detectorType DetectorType  @map("detector_type")
  sourceId     String        @map("source_id")
  count        Int

  @@id([day, severity, status, detectorType, sourceId])
  @@index([day])
  @@map("finding_stats_first_daily")
}

/// Per-asset counts keyed on `first_detected_at`, for the charts' top-assets
/// panel. Carries no `lastDetectedAt`: that panel ranks by volume and severity
/// only, so storing a timestamp nothing reads would be dead weight.
model FindingStatFirstAssetDaily {
  day      DateTime      @db.Date
  assetId  String        @map("asset_id")
  severity Severity
  status   FindingStatus
  count    Int

  @@id([day, assetId, severity, status])
  @@index([day])
  @@map("finding_stats_first_asset_daily")
}
