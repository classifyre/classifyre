{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "API_URL",
    "INTERNAL_API_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "NEXT_PUBLIC_POSTHOG_UI_HOST",
    "POSTHOG_INGEST_HOST",
    "GOOGLE_ANALYTICS_MEASUREMENT_ID",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID",
    "SITEMAP_ENABLED",
    "SITEMAP_BASE_URL",
    "SITEMAP_CHUNK_SIZE",
    "PUBLIC_BASE_URL",
    "DESKTOP_BUILD",
    "NODE_ENV",
    "GITHUB_TOKEN",
    "GH_TOKEN"
  ],
  "tasks": {
    "prisma:generate": {
      "cache": true,
      "outputs": [
        "node_modules/.prisma/client/**",
        "node_modules/@prisma/client/**"
      ]
    },
    "build": {
      "dependsOn": ["^build", "prisma:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "out/**",
        "src/generated/**",
        ".venv/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint", "prisma:generate"]
    },
    "codegen": {
      "cache": false
    },
    "@classifyre/api#codegen": {
      "cache": false,
      // Generating the OpenAPI spec boots the whole Nest application, which
      // imports PrismaService — so it needs a generated Prisma client, exactly
      // as build/lint/check-types do. Locally that client is already there from
      // an earlier task and the dependency is invisible; on a clean CI checkout
      // it is not, and the task fails with "Cannot find module
      // '.prisma/client/default'".
      "dependsOn": ["prisma:generate"]
    },
    "@workspace/api-client#codegen": {
      "cache": false,
      // The client is generated FROM apps/api/openapi.json, so the spec has to
      // be rebuilt first or `bun codegen` silently produces a client for
      // whatever the API looked like the last time someone remembered to run
      // `openapi:generate` by hand.
      "dependsOn": ["@classifyre/api#codegen"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "prisma:generate"]
    },
    "dev": {
      "dependsOn": ["prisma:generate"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "desktop#dev": {
      "dependsOn": ["prisma:generate"],
      "cache": false,
      "persistent": true
    },
    "desktop#make": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "docker:build": {
      "cache": false
    },
    "docker:build:multiarch": {
      "cache": false
    },
    "helm:lint": {
      "cache": false
    },
    "helm:docs": {
      "cache": false
    },
    "helm:docs:check": {
      "cache": false
    },
    "helm:snapshot": {
      "cache": false
    },
    "helm:snapshot:check": {
      "cache": false
    },
    "helm:test": {
      "cache": false,
      "dependsOn": ["helm:lint", "helm:docs:check", "helm:snapshot:check"]
    }
  }
}
