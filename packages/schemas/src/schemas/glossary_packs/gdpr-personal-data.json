{
  "format": "classifyre.glossary-pack/v1",
  "key": "gdpr-personal-data",
  "version": "1.0.0",
  "name": "GDPR personal data",
  "language": "en",
  "description": "Categories of personal data under the GDPR, bound to the built-in PII detector's outputs. Art. 9 special categories have no built-in detector; G2 detector bundles bind to them by key.",
  "sources": [
    "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
  ],
  "schemes": [
    {
      "key": "gdpr-personal-data",
      "name": "GDPR personal data",
      "description": "Personal data and its categories (GDPR Art. 4(1) and Art. 9)."
    }
  ],
  "terms": [
    {
      "key": "personal-data",
      "kind": "CONCEPT",
      "term": "Personal data",
      "scheme": "gdpr-personal-data",
      "definition": "Any information relating to an identified or identifiable natural person (GDPR Art. 4(1)).",
      "aliases": [
        "personenbezogene Daten",
        "PII"
      ]
    },
    {
      "key": "identification-data",
      "kind": "CONCEPT",
      "term": "Identification data",
      "scheme": "gdpr-personal-data",
      "definition": "Data that identifies a person directly: names and official identifiers."
    },
    {
      "key": "person-name",
      "kind": "CONCEPT",
      "term": "Person name",
      "scheme": "gdpr-personal-data",
      "definition": "A natural person's name.",
      "aliases": [
        "name of a person",
        "Personenname"
      ]
    },
    {
      "key": "national-identification-number",
      "kind": "CONCEPT",
      "term": "National identification number",
      "scheme": "gdpr-personal-data",
      "definition": "An identifier a state issues to a person: social security, tax, health or national ID numbers.",
      "aliases": [
        "national ID",
        "Sozialversicherungsnummer",
        "social security number"
      ]
    },
    {
      "key": "passport-number",
      "kind": "CONCEPT",
      "term": "Passport number",
      "scheme": "gdpr-personal-data",
      "definition": "The number of a passport.",
      "aliases": [
        "Reisepassnummer"
      ]
    },
    {
      "key": "driver-licence-number",
      "kind": "CONCEPT",
      "term": "Driver's licence number",
      "scheme": "gdpr-personal-data",
      "definition": "The number of a driving licence.",
      "aliases": [
        "driver license number",
        "Führerscheinnummer"
      ]
    },
    {
      "key": "contact-data",
      "kind": "CONCEPT",
      "term": "Contact data",
      "scheme": "gdpr-personal-data",
      "definition": "Data used to reach a person.",
      "aliases": [
        "Kontaktdaten"
      ]
    },
    {
      "key": "email-address",
      "kind": "CONCEPT",
      "term": "E-mail address",
      "scheme": "gdpr-personal-data",
      "definition": "An electronic mail address.",
      "aliases": [
        "email",
        "e-mail",
        "E-Mail-Adresse"
      ]
    },
    {
      "key": "phone-number",
      "kind": "CONCEPT",
      "term": "Phone number",
      "scheme": "gdpr-personal-data",
      "definition": "A telephone number.",
      "aliases": [
        "telephone number",
        "Telefonnummer"
      ]
    },
    {
      "key": "location-or-address",
      "kind": "CONCEPT",
      "term": "Location or address",
      "scheme": "gdpr-personal-data",
      "definition": "A postal address or a place associated with a person.",
      "aliases": [
        "address",
        "Adresse",
        "location"
      ]
    },
    {
      "key": "financial-data",
      "kind": "CONCEPT",
      "term": "Financial data",
      "scheme": "gdpr-personal-data",
      "definition": "Data about a person's finances, accounts and payment instruments.",
      "aliases": [
        "Finanzdaten"
      ]
    },
    {
      "key": "bank-account-iban",
      "kind": "CONCEPT",
      "term": "Bank account (IBAN)",
      "scheme": "gdpr-personal-data",
      "definition": "An International Bank Account Number.",
      "aliases": [
        "IBAN",
        "bank account",
        "Bankverbindung"
      ]
    },
    {
      "key": "payment-card-number",
      "kind": "CONCEPT",
      "term": "Payment card number",
      "scheme": "gdpr-personal-data",
      "definition": "The number of a credit or debit card.",
      "aliases": [
        "credit card number",
        "Kreditkartennummer"
      ]
    },
    {
      "key": "online-identifiers",
      "kind": "CONCEPT",
      "term": "Online identifiers",
      "scheme": "gdpr-personal-data",
      "definition": "Identifiers devices and services assign: IP addresses, cookie and device IDs (GDPR Recital 30).",
      "aliases": [
        "online identifier"
      ]
    },
    {
      "key": "ip-address",
      "kind": "CONCEPT",
      "term": "IP address",
      "scheme": "gdpr-personal-data",
      "definition": "An Internet Protocol address.",
      "aliases": [
        "IP-Adresse"
      ]
    },
    {
      "key": "nationality-religious-political-group",
      "kind": "CONCEPT",
      "term": "Nationality, religious or political group",
      "scheme": "gdpr-personal-data",
      "definition": "A person's nationality or membership of a religious or political group (Presidio NRP).",
      "aliases": [
        "NRP"
      ]
    },
    {
      "key": "special-categories",
      "kind": "CONCEPT",
      "term": "Special categories (Art. 9)",
      "scheme": "gdpr-personal-data",
      "definition": "Personal data revealing racial or ethnic origin, political opinions, religious or philosophical beliefs, trade-union membership, genetic, biometric or health data, or data concerning sex life or sexual orientation (GDPR Art. 9(1)).",
      "aliases": [
        "sensitive personal data",
        "besondere Kategorien personenbezogener Daten"
      ]
    },
    {
      "key": "health-data",
      "kind": "CONCEPT",
      "term": "Health data",
      "scheme": "gdpr-personal-data",
      "definition": "Personal data related to the physical or mental health of a person (GDPR Art. 4(15)).",
      "aliases": [
        "Gesundheitsdaten",
        "data concerning health"
      ]
    },
    {
      "key": "genetic-data",
      "kind": "CONCEPT",
      "term": "Genetic data",
      "scheme": "gdpr-personal-data",
      "definition": "Personal data relating to inherited or acquired genetic characteristics (GDPR Art. 4(13)).",
      "aliases": [
        "genetische Daten"
      ]
    },
    {
      "key": "biometric-data",
      "kind": "CONCEPT",
      "term": "Biometric data",
      "scheme": "gdpr-personal-data",
      "definition": "Personal data from technical processing of physical, physiological or behavioural characteristics that allow unique identification (GDPR Art. 4(14)).",
      "aliases": [
        "biometrische Daten"
      ]
    },
    {
      "key": "racial-or-ethnic-origin",
      "kind": "CONCEPT",
      "term": "Racial or ethnic origin",
      "scheme": "gdpr-personal-data",
      "definition": "Data revealing racial or ethnic origin.",
      "aliases": [
        "ethnic origin"
      ]
    },
    {
      "key": "political-opinions",
