      "definition": "Data revealing religious or philosophical beliefs.",
      "aliases": [
        "religious beliefs"
      ]
    },
    {
      "key": "trade-union-membership",
      "kind": "CONCEPT",
      "term": "Trade-union membership",
      "scheme": "gdpr-personal-data",
