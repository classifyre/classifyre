#!/command/with-contenv bash
# The Classifyre API — and, at SERVICE_ROLE=all, its background worker too.
#
# This one process is the whole backend: HTTP + WebSockets, the pg-boss job
# queues, the forked ONNX embedding child, and the parent of every Python scan
# subprocess. It also applies database migrations itself, before Nest starts
# (apps/api/src/main.ts), under a Postgres advisory lock.
set -euo pipefail

PGPORT="${PGPORT:-5432}"

# pg_isready understands a connection URI, so the same wait works for the
# bundled server and for an external DATABASE_URL.
echo "api: waiting for the database"
for _ in $(seq 1 180); do
  if pg_isready -d "${DATABASE_URL}" >/dev/null 2>&1; then
    break
  fi
  sleep 1
done
if ! pg_isready -d "${DATABASE_URL}" >/dev/null 2>&1; then
  echo "api: database did not become ready in 180s" >&2
  exit 1
fi

# initdb creates only the superuser's own database, so on a first boot the
# target database does not exist yet. An external DATABASE_URL is the operator's
# to provision.
if [ "${CLASSIFYRE_BUNDLED_POSTGRES:-1}" = "1" ]; then
  db="${POSTGRES_DB:-classifyre}"
  if ! psql -h 127.0.0.1 -p "${PGPORT}" -U "${POSTGRES_USER:-postgres}" -tAc \
        "SELECT 1 FROM pg_database WHERE datname='${db}'" | grep -q 1; then
    echo "api: creating database ${db}"
    psql -h 127.0.0.1 -p "${PGPORT}" -U "${POSTGRES_USER:-postgres}" \
      -v ON_ERROR_STOP=1 -c "CREATE DATABASE \"${db}\";"
  fi
fi

if [ ! -x "${VENV_PATH:-/app/apps/cli/.venv}/bin/python" ]; then
  echo "api: no Python virtualenv at ${VENV_PATH:-/app/apps/cli/.venv} — scans cannot run" >&2
  exit 1
fi

cd /app/api
exec s6-setuidgid classifyre \
  env PORT="${API_PORT:-8000}" \
  node dist/src/main.js
